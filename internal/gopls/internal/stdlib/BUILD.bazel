load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "stdlib",
    srcs = [
        "deps.go",
        "import.go",
        "manifest.go",
        "stdlib.go",
    ],
    importpath = "github.com/conductorone/plaid-lint/internal/gopls/internal/stdlib",
    visibility = ["//internal/gopls:__subpackages__"],
)

go_test(
    name = "stdlib_test",
    srcs = ["deps_test.go"],
    data = glob(["testdata/**"]),
    deps = [
        ":stdlib",
        "@com_github_google_go_cmp//cmp",
    ],
)
