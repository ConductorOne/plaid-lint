load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "unit",
    srcs = [
        "collect.go",
        "config.go",
        "constraints.go",
        "exec.go",
        "facts_io.go",
        "hermetic.go",
        "importcfg.go",
        "module_mode.go",
        "typecheck.go",
        "unit.go",
    ],
    importpath = "github.com/conductorone/plaid-lint/internal/unit",
    visibility = ["//:__subpackages__"],
    deps = [
        "//internal/config",
        "//internal/exclusion",
        "//internal/gopls/driverutil",
        "//internal/gopls/facts",
        "//internal/output",
        "//internal/registry",
