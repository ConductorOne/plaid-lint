# plaid_lint — golangci-lint-compatible Go linting as native Bazel
# actions. See bazel/defs.bzl for the consumer API and README.md
# ("Bazel" section) for setup.
module(
    name = "plaid_lint",
    version = "0.0.0",
)

bazel_dep(name = "rules_go", version = "0.62.0")
bazel_dep(name = "gazelle", version = "0.52.2")
bazel_dep(name = "bazel_skylib", version = "1.7.1")

go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")

# go.mod's `go 1.26` directive names a language version, not a
# downloadable toolchain; pin the SDK patch release explicitly.
go_sdk.download(version = "1.26.5")

go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")

# The repositories the plaid-lint binary itself needs. Keep in sync
# with `bazel mod tidy`.
use_repo(
    go_deps,
    "cc_mvdan_unparam",
