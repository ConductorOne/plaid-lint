build:lint --aspects=//tools/lint:linters.bzl%plaid
build:lint --output_groups=+plaid_report

# Aggregate suite configuration (plaid_lint_suite_test).
common --@plaid_lint//bazel:config=//:.golangci.yml
common --@plaid_lint//bazel:module_path=example.com/plaidexample

# //exportgraph/greetpb's protoc: the prebuilt release binary through
# proto toolchain resolution, instead of compiling protoc from source.
common --incompatible_enable_proto_toolchain_resolution
common --@protobuf//bazel/toolchains:prefer_prebuilt_protoc
