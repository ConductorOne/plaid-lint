load("@plaid_lint//bazel:defs.bzl", "plaid_module_lint")

plaid_module_lint(
    name = "module_lint",
    config = "//:.golangci.yml",
    go_mod = "//:go.mod",
    module_path = "example.com/plaidexample",
)

exports_files(
    [".golangci.yml", "bad-config.yml", "go.mod"],
    visibility = ["//visibility:public"],
)

load("@plaid_lint//bazel:defs.bzl", "plaid_lint_suite_test")

# The aggregate lint gate over the whole example (deliberately RED:
# it must surface exactly the seeded findings — see e2e.sh).
plaid_lint_suite_test(
    name = "lint",
    go_mod = ":go.mod",
    module_path = "example.com/plaidexample",
    tags = ["manual"],  # red by design; run explicitly from e2e
    targets = [
        "//app",
        "//lib",
        "//lib:lib_test",
        "//unusedpkg",
        "//unusedpkg:unusedpkg_test",
        # No-embed, external-tests-only go_test (label-derived archive
        # importpaths): pins testfilter-keyed classification and
        # label-package facts_only matching through the suite.
        "//xtestonly",
        "//xtestonly:xtestonly_test",
    ],
)

# A clean scope: lib's only finding (unused testOnly) is superseded by
# the in-package test archive, so this suite passes.
plaid_lint_suite_test(
    name = "lint_clean",
    tags = ["manual"],
    targets = [
        "//lib",
        "//lib:lib_test",
    ],
)

# The same root under both report scopes. //app imports //lib, whose
# unused `testOnly` has no superseding test archive in this scope, so
# the default (transitive) suite reports it alongside //app's own
# seeded findings.
plaid_lint_suite_test(
    name = "lint_app_transitive",
    tags = ["manual"],  # red by design; run explicitly from e2e
    targets = ["//app"],
)

# report_scope = "targets": only //app is a lint subject. //lib's own
# findings leave the scope, but //lib is still analyzed and still
# supplies //app's analysis with its export data and .plaidfacts —
# which is why //app's printf finding, detectable ONLY through
# //lib's exported printf-wrapper fact, survives the narrowing.
plaid_lint_suite_test(
    name = "lint_app_direct",
    report_scope = "targets",
    tags = ["manual"],  # red by design; run explicitly from e2e
    targets = ["//app"],
)

# A source-less wrapper contributes no reports of its own. Under
# report_scope = "targets" that is a configuration error, not a
# silently empty gate (e2e asserts the analysis-time failure).
plaid_lint_suite_test(
    name = "lint_wrapper_direct",
    report_scope = "targets",
    tags = ["manual"],
    targets = ["//wrapper"],
)
